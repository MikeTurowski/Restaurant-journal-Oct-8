# Copy to `.env.local` (git-ignored) and fill in your project's values.
# If either variable is missing, the app falls back to the built-in mock data.
# Use the publishable (anon) key only. NEVER put a service_role / secret key in a VITE_ variable:
# anything prefixed VITE_ is shipped to the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key-here
